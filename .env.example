DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expresshub?schema=public"
ALLOWED_ORIGIN="http://localhost:3000"
JWT_ACCESS_SECRET=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Set only behind a trusted ingress that overwrites this header with a single IP.
# Allowed: x-real-ip or x-forwarded-for. Empty uses x-real-ip on Vercel and a shared
# anonymous bucket elsewhere. Refresh and logout are limited per session either way.
RATE_LIMIT_IP_HEADER=""
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Server-configured return URLs. Redirects do not confirm payment.
STRIPE_SUCCESS_URL="http://localhost:3000/checkout/success?session_id={CHECKOUT_SESSION_ID}"
STRIPE_CANCEL_URL="http://localhost:3000/checkout/cancel"
# AI shipment assistant. Off unless AI_ENABLED is "true" and the chosen provider's key is set.
AI_ENABLED="false"
# "anthropic" (default) or "gemini". Gemini has a free tier: get a key at https://aistudio.google.com/apikey
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
# Also used for the help chat embeddings, whichever AI_PROVIDER is chosen.
GEMINI_API_KEY=""
# Optional model override. Defaults to claude-opus-5-5 or gemini-3.1-flash-lite.
AI_MODEL=""
# Shipment email notifications through Brevo (no domain needed: verify a single sender address
# and use exactly that address in NOTIFICATIONS_FROM). Without both, emails are only logged.
APP_URL="http://localhost:3000"
BREVO_API_KEY=""
NOTIFICATIONS_FROM=""
# At least 16 random characters; Vercel Cron sends it to /api/v1/internal/notifications/dispatch.
CRON_SECRET=""
# Encrypts webhook signing secrets: 32 random bytes, base64 (openssl rand -base64 32). Without it, webhook endpoints are unavailable.
WEBHOOK_ENCRYPTION_KEY=""
