{
  "name": "expresshub",
  "version": "1.0.0",
  "description": "Courier and logistics management API built with Next.js and Prisma",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:auth": "node --test tests/auth.test.mjs",
    "test:auth:integration": "node tests/auth.integration.mjs",
    "test:users:integration": "node tests/users.integration.mjs",
    "test:shipments:integration": "node tests/shipments.integration.mjs",
    "test:payments": "node --test tests/payments.test.mjs tests/payment-controller.test.mjs",
    "test:ai": "node --test tests/ai-assistant.test.mjs tests/ai-booking.test.mjs tests/ai-ops-brief.test.mjs tests/ai-dispatch.test.mjs",
    "test:checkout-return": "node --test tests/checkout-return.test.mjs",
    "stripe:check": "node scripts/check-stripe.mjs",
    "test:payments:integration": "node tests/payments.integration.mjs",
    "test:admin:integration": "node tests/admin.integration.mjs",
    "test:lists:integration": "node tests/lists.integration.mjs",
    "test:pagination": "node --test tests/pagination.test.mjs",
    "test:soft-delete:integration": "node tests/soft-delete.integration.mjs",
    "test:errors": "node --test tests/errors.test.mjs",
    "test:security": "node --test tests/security.test.mjs tests/route-protection.test.mjs",
    "test:errors:integration": "node tests/errors.integration.mjs",
    "test:notifications": "node --test tests/notifications.test.mjs",
    "test:notifications:integration": "node tests/notifications.integration.mjs",
    "test:proof": "node --test tests/proof.test.mjs",
    "test:labels": "node --test tests/labels.test.mjs",
    "test:proof:integration": "node tests/proof.integration.mjs",
    "test:labels:integration": "node tests/labels.integration.mjs",
    "test:misc": "node --test tests/postman.test.mjs tests/profile-photo.test.mjs tests/rate-limit-diagnostics.test.mjs tests/count-up.test.mjs",
    "test": "npm run test:auth && npm run test:payments && npm run test:ai && npm run test:checkout-return && npm run test:pagination && npm run test:errors && npm run test:security && npm run test:frontend && npm run test:tracking && npm run test:notifications && npm run test:analytics && npm run test:proof && npm run test:labels && npm run test:help && npm run test:merchant && npm run test:misc",
    "test:help": "node --test tests/help.test.mjs",
    "test:help:integration": "node --env-file-if-exists=.env tests/help.integration.mjs",
    "help:index": "node --env-file-if-exists=.env scripts/index-help.mjs",
    "eval:help": "node --env-file-if-exists=.env tests/evals/help.eval.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:seed": "node prisma/seed.mjs",
    "prisma:seed:pricing": "node prisma/seed-pricing.mjs",
    "test:frontend": "node --test tests/query-cache.test.mjs tests/form-validation.test.mjs tests/frontend-auth.test.mjs tests/frontend-shipments.test.mjs tests/frontend-payments.test.mjs tests/frontend-operations.test.mjs tests/frontend-admin.test.mjs tests/frontend-workflows.test.mjs",
    "test:frontend:browser": "playwright test",
    "test:e2e": "playwright test -c playwright.e2e.config.ts",
    "test:e2e:ui": "playwright test -c playwright.e2e.config.ts --ui",
    "e2e:seed": "node --env-file-if-exists=.env prisma/seed-e2e.mjs",
    "e2e:cleanup": "node --env-file-if-exists=.env prisma/seed-e2e.mjs --cleanup",
    "test:load": "k6 run tests/load/smoke.js",
    "test:tracking": "node --test tests/tracking.test.mjs tests/courier-location.test.mjs",
    "test:tracking:integration": "node tests/tracking.integration.mjs",
    "test:location:integration": "node tests/courier-location.integration.mjs",
    "test:analytics": "node --test tests/analytics.test.mjs",
    "test:analytics:integration": "node tests/analytics.integration.mjs",
    "test:dispatch:integration": "node tests/dispatch.integration.mjs",
    "test:merchant": "node --test tests/merchant.test.mjs",
    "test:merchant:integration": "node tests/merchant.integration.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.64.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "1.9.22",
    "@types/node": "^26.6.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prisma": "^5.22.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@google/genai": "^3.3.0",
    "@gsap/react": "2.1.2",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.5",
    "framer-motion": "^14.1.0",
    "gsap": "3.15.0",
    "jsonwebtoken": "^9.0.3",
    "jsqr": "1.4.0",
    "leaflet": "1.9.4",
    "lucide-react": "^1.55.0",
    "next": "^16.4.6",
    "next-intl": "4.14.9",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "recharts": "3.10.1",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  }
}
