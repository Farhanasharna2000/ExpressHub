generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  COURIER
  ADMIN
}

enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  SSLCOMMERZ
  BKASH
}

enum ShipmentEventType {
  CREATED
  COURIER_ASSIGNED
  STATUS_CHANGED
  HUB_TRANSFER
  DELIVERY_ATTEMPT
  CUSTOMER_CANCELLED
  ADMIN_CORRECTION
}

enum AuditEntityType {
  USER
  SHIPMENT
  PAYMENT
  HUB
  PRICING_RULE
}

enum NotificationType {
  SHIPMENT_BOOKED
  SHIPMENT_PICKED_UP
  SHIPMENT_OUT_FOR_DELIVERY
  SHIPMENT_DELIVERED
  SHIPMENT_FAILED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  DEAD
  SKIPPED
  // An admin chose not to send a DEAD email (for example an old one); never retried.
  DISMISSED
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               UserRole  @default(CUSTOMER)
  phone              String?
  avatar             String?   @db.Text
  isActive           Boolean   @default(true)
  emailNotifications Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  customerShipments Shipment[]           @relation("ShipmentCustomer")
  courierShipments  Shipment[]           @relation("ShipmentCourier")
  payments          Payment[]
  refreshTokens     RefreshToken[]
  shipmentEvents    ShipmentEvent[]
  auditLogs         AuditLog[]           @relation("AuditActor")
  pricingRules      PricingRule[]        @relation("PricingRuleCreator")
  notifications     NotificationOutbox[]
  deliveryProofs    DeliveryProof[]      @relation("DeliveryProofCourier")
  courierLocation   CourierLocation?
  apiKeys           ApiKey[]
  webhookEndpoints  WebhookEndpoint[]

  @@index([role, isActive, deletedAt])
  @@index([createdAt])
  @@map("users")
}

model Shipment {
  id               String  @id @default(cuid())
  trackingNumber   String  @unique
  customerId       String
  courierId        String?
  originHubId      String?
  destinationHubId String?
  currentHubId     String?

  pickupContactName    String
  pickupContactPhone   String
  pickupAddress        String
  deliveryContactName  String
  deliveryContactPhone String
  deliveryAddress      String

  packageDescription String?
  parcelWeightKg     Decimal        @db.Decimal(10, 3)
  parcelLengthCm     Decimal?       @db.Decimal(10, 2)
  parcelWidthCm      Decimal?       @db.Decimal(10, 2)
  parcelHeightCm     Decimal?       @db.Decimal(10, 2)
  price              Decimal        @db.Decimal(12, 2)
  currency           String         @default("BDT") @db.VarChar(3)
  status             ShipmentStatus @default(CREATED)
  paymentStatus      PaymentStatus  @default(PENDING)
  pickupScheduledAt  DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  customer User  @relation("ShipmentCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  courier  User? @relation("ShipmentCourier", fields: [courierId], references: [id], onDelete: SetNull)

  originHub      Hub? @relation("ShipmentOriginHub", fields: [originHubId], references: [id], onDelete: SetNull)
  destinationHub Hub? @relation("ShipmentDestinationHub", fields: [destinationHubId], references: [id], onDelete: SetNull)
  currentHub     Hub? @relation("ShipmentCurrentHub", fields: [currentHubId], references: [id], onDelete: SetNull)

  events        ShipmentEvent[]
  payments      Payment[]
  auditLogs     AuditLog[]
  notifications NotificationOutbox[]
  deliveryProof DeliveryProof?

  @@index([customerId, createdAt])
  @@index([courierId, status, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, status])
  @@index([originHubId])
  @@index([destinationHubId])
  @@index([currentHubId, status])
  @@index([deletedAt])
  @@map("shipments")
}

model Hub {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  address   String
  zoneCode  String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  originShipments      Shipment[]      @relation("ShipmentOriginHub")
  destinationShipments Shipment[]      @relation("ShipmentDestinationHub")
  currentShipments     Shipment[]      @relation("ShipmentCurrentHub")
  outgoingEvents       ShipmentEvent[] @relation("EventOriginHub")
  incomingEvents       ShipmentEvent[] @relation("EventDestinationHub")

  @@index([zoneCode, isActive, deletedAt])
  @@map("hubs")
}

model ShipmentEvent {
  id               String            @id @default(cuid())
  shipmentId       String
  actorId          String?
  type             ShipmentEventType
  fromStatus       ShipmentStatus?
  toStatus         ShipmentStatus?
  originHubId      String?
  destinationHubId String?
  publicNote       String?
  internalNote     String?
  occurredAt       DateTime          @default(now())
  createdAt        DateTime          @default(now())

  shipment       Shipment             @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  actor          User?                @relation(fields: [actorId], references: [id], onDelete: SetNull)
  notifications  NotificationOutbox[]
  originHub      Hub?                 @relation("EventOriginHub", fields: [originHubId], references: [id], onDelete: SetNull)
  destinationHub Hub?                 @relation("EventDestinationHub", fields: [destinationHubId], references: [id], onDelete: SetNull)

  @@index([shipmentId, occurredAt])
  @@index([actorId, occurredAt])
  @@map("shipment_events")
}

model Payment {
  id                String          @id @default(cuid())
  shipmentId        String
  payerId           String
  provider          PaymentProvider
  providerReference String?         @unique
  providerIntentId  String?         @unique
  checkoutRequest   Json?
  checkoutUrl       String?
  checkoutExpiresAt DateTime?
  idempotencyKey    String          @unique
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("BDT") @db.VarChar(3)
  status            PaymentStatus   @default(PENDING)
  paidAt            DateTime?
  refundedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  shipment      Shipment              @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  payer         User                  @relation(fields: [payerId], references: [id], onDelete: Restrict)
  webhookEvents PaymentWebhookEvent[]
  auditLogs     AuditLog[]

  @@index([shipmentId, status, createdAt])
  @@index([payerId, createdAt])
  @@index([provider, status, createdAt])
  @@map("payments")
}

model PaymentWebhookEvent {
  id               String                  @id @default(cuid())
  provider         PaymentProvider
  providerEventId  String
  paymentId        String?
  eventType        String
  payloadHash      String
  processingStatus WebhookProcessingStatus @default(RECEIVED)
  receivedAt       DateTime                @default(now())
  processedAt      DateTime?

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([paymentId, receivedAt])
  @@index([processingStatus, receivedAt])
  @@map("payment_webhook_events")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("refresh_tokens")
}

model PricingRule {
  id                 String    @id @default(cuid())
  name               String
  minWeightKg        Decimal   @db.Decimal(10, 3)
  maxWeightKg        Decimal   @db.Decimal(10, 3)
  baseFee            Decimal   @db.Decimal(12, 2)
  additionalPerKgFee Decimal   @default(0) @db.Decimal(12, 2)
  currency           String    @default("BDT") @db.VarChar(3)
  isActive           Boolean   @default(true)
  effectiveFrom      DateTime  @default(now())
  effectiveTo        DateTime?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  createdBy User? @relation("PricingRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive, effectiveFrom, effectiveTo])
  @@index([minWeightKg, maxWeightKg])
  @@map("pricing_rules")
}

model AuditLog {
  id         String          @id @default(cuid())
  actorId    String?
  entityType AuditEntityType
  entityId   String
  shipmentId String?
  paymentId  String?
  action     String
  details    Json?
  createdAt  DateTime        @default(now())

  actor    User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  payment  Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([shipmentId, createdAt])
  @@index([paymentId, createdAt])
  @@map("audit_logs")
}

// Transactional outbox: rows are written in the same transaction as the shipment
// change and sent afterwards, so a rolled-back change never emails anyone.
model NotificationOutbox {
  id              String             @id @default(cuid())
  type            NotificationType
  shipmentId      String
  eventId         String
  recipientUserId String
  payload         Json
  status          NotificationStatus @default(PENDING)
  attempts        Int                @default(0)
  nextAttemptAt   DateTime           @default(now())
  lastError       String?
  sentAt          DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  shipment  Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  event     ShipmentEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipient User          @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, type, eventId])
  @@index([status, nextAttemptAt])
  @@index([recipientUserId, createdAt])
  @@map("notification_outbox")
}

// Proof a courier captured at the door. Images live in proof storage under random
// keys; this row only records who captured what, when, and for which shipment.
model DeliveryProof {
  id            String   @id @default(cuid())
  shipmentId    String   @unique
  courierId     String
  recipientName String   @db.VarChar(100)
  photoKey      String?  @db.VarChar(64)
  signatureKey  String?  @db.VarChar(64)
  capturedAt    DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  courier  User     @relation("DeliveryProofCourier", fields: [courierId], references: [id], onDelete: Cascade)

  @@index([courierId, capturedAt])
  @@map("delivery_proofs")
}

// Postgres-backed blob store used by the default ProofStorage driver.
model StoredFile {
  key         String   @id @db.VarChar(64)
  contentType String   @db.VarChar(40)
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  @@map("stored_files")
}

// One retrievable piece of a help article in docs/help. The embedding column and its
// HNSW and full-text indexes are created in SQL; Prisma reads and writes the text fields.
model HelpChunk {
  id           String                     @id @default(cuid())
  articleSlug  String                     @db.VarChar(80)
  articleTitle String                     @db.VarChar(160)
  heading      String                     @db.VarChar(200)
  anchor       String                     @db.VarChar(200)
  position     Int
  content      String                     @db.Text
  contentHash  String                     @db.VarChar(64)
  model        String                     @db.VarChar(80)
  embedding    Unsupported("vector(768)")
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@unique([articleSlug, position])
  @@map("help_chunks")
}

// A courier's latest shared position while out for delivery. One row per courier and
// no history: each update overwrites it, and a row older than 10 minutes counts as stale.
model CourierLocation {
  courierId String   @id
  latitude  Float
  longitude Float
  accuracy  Float
  heading   Float?
  speed     Float?
  updatedAt DateTime

  courier User @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
  @@map("courier_locations")
}

enum WebhookDeliveryStatus {
  PENDING
  SENT
  FAILED
  DEAD
}

// Merchant API key. Only the SHA-256 hash of the full key is stored; the prefix
// identifies the key in lists and is used to look it up.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  prefix     String    @unique
  keyHash    String    @unique
  scopes     String[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("api_keys")
}

// The signing secret is needed to sign each delivery, so it is encrypted at rest
// (AES-256-GCM with WEBHOOK_ENCRYPTION_KEY) instead of hashed.
model WebhookEndpoint {
  id              String   @id @default(cuid())
  userId          String
  url             String
  description     String?
  events          String[]
  active          Boolean  @default(true)
  encryptedSecret String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([userId, createdAt])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  endpointId     String
  // Stable id sent as ExpressHub-Event-Id; receivers use it to drop duplicates.
  eventId        String
  eventType      String
  shipmentId     String?
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now())
  lastStatusCode Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}
